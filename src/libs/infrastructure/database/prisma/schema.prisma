model CommunicationTemplate {
  id        String   @id @default(uuid())
  name      String // Template name (e.g., 'Appointment Reminder')
  type      String // 'EMAIL', 'SMS', 'WHATSAPP'
  category  String // 'APPOINTMENT', 'EHR', 'BILLING', 'SYSTEM'
  subject   String? // For Email
  content   String // The template body with placeholders {{variable}}
  metadata  Json? // Channel-specific metadata (e.g., WhatsApp template ID, Push title)
  clinicId  String? // Optional: clinic-specific template
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([name, type, clinicId])
  @@index([clinicId])
  @@index([type])
  @@index([category])
}

model SystemSetting {
  settingKey   String   @id
  settingValue String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("system_settings")
}
