generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                    @id @default(uuid())
  userid                  String                    @unique
  email                   String?                   @unique
  password                String?
  name                    String
  age                     Int?
  firstName               String?
  lastName                String?
  phone                   String?                   @unique
  phoneVerified           Boolean                   @default(false)
  phoneVerifiedAt         DateTime?
  role                    Role                      @default(PATIENT)
  profilePicture          String?
  gender                  String?
  dateOfBirth             DateTime?
  address                 String?
  city                    String?
  state                   String?
  country                 String?
  zipCode                 String?
  emergencyContact        String?
  isVerified              Boolean                   @default(false)
  isActive                Boolean                   @default(true)
  isProfileComplete       Boolean                   @default(false)
  profileCompletedAt      DateTime?
  lastLogin               DateTime?
  lastLoginIP             String?
  lastLoginDevice         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  passwordChangedAt       DateTime?
  googleId                String?
  facebookId              String?
  appleId                 String?
  appName                 String?
  medicalConditions       String?
  prakriti                Prakriti?
  vikriti                 String?
  doshaImbalances         Json?
  agni                    AgniType?
  dinacharya              String?
  ritucharya              String?
  dietaryRestrictionsJson Json?
  lifestyleFactors        Json?
  seasonalPatterns        Json?
  primaryClinicId         String?
  deletedAt               DateTime?
  allergies               Allergy[]
  appointments            Appointment[]
  auditLogs               AuditLog[]
  ayurvedicPrescriptions  AyurvedicPrescription[]
  clinicAdmins            ClinicAdmin?
  counselor               Counselor?
  dietaryRestrictions     DietaryRestriction[]
  doctor                  Doctor?
  emergencyContacts       EmergencyContact[]
  familyHistories         FamilyHistory[]
  financeBilling          FinanceBilling?
  immunizations           Immunization[]
  insurances              Insurance[]
  labReports              LabReport[]
  labTechnician           LabTechnician?
  lifestyleAssessments    LifestyleAssessment[]
  locationHead            LocationHead?
  medicalHistories        MedicalHistory[]
  medications             Medication[]
  mentalHealthNotes       MentalHealthNote[]
  nadiParikshas           NadiPariksha[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  nurse                   Nurse?
  patient                 Patient?
  familyMembers           FamilyMember[]            @relation("PrimaryPatientFamilyMembers")
  createdFamilyMembers    FamilyMember[]            @relation("FamilyMemberCreatedByUser")
  pharmacist              Pharmacist?
  prakritiAnalyses        PrakritiAnalysis[]
  radiologyReports        RadiologyReport[]
  receptionists           Receptionist?
  superAdmin              SuperAdmin?
  supportStaff            SupportStaff?
  surgicalRecords         SurgicalRecord[]
  therapist               Therapist?
  userRoles               UserRole[]
  vitals                  Vital[]
  createdClinics          Clinic[]                  @relation("UserCreatedClinics")
  primaryClinic           Clinic?                   @relation("UserPrimaryClinic", fields: [primaryClinicId], references: [id])
  videoParticipants       VideoParticipant[]
  videoChatMessages       VideoChatMessage[]
  videoConsultationNotes  VideoConsultationNote[]   @relation("VideoNoteUser")
  videoAnnotations        VideoAnnotation[]         @relation("VideoAnnotationUser")
  waitingRoomEntries      WaitingRoomEntry[]        @relation("WaitingRoomUser")
  clinics                 Clinic[]                  @relation("UserClinics")
  emailSuppressions       EmailSuppressionList[]
  whatsappSuppressions    WhatsAppSuppressionList[]
  communicationTemplates  CommunicationTemplate[]
  clinicExpenses          ClinicExpense[]
  ipdVitalsRecorded       VitalsFlowsheet[]         @relation("IpdVitalsRecordedBy")
  ipdMedicationsAdministered BedsideMedication[]     @relation("IpdMedicationAdministeredBy")
  ipdMedicationsVerified  BedsideMedication[]       @relation("IpdMedicationVerifiedBy")

  @@index([primaryClinicId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Receptionist {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  clinicId              String?
  locationId            String?
  createdAt             DateTime                @default(now())
  clinic                Clinic?                 @relation(fields: [clinicId], references: [id])
  location              ClinicLocation?         @relation(fields: [locationId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id])
  ReceptionistsAtClinic ReceptionistsAtClinic[]

  @@index([clinicId])
  @@index([locationId])
}

model Clinic {
  id                           String                              @id @default(uuid())
  clinicId                     String                              @unique
  name                         String
  address                      String
  phone                        String
  email                        String                              @unique
  app_name                     String                              @unique
  whatsappName                 String? // Short name for WhatsApp templates (max 15 chars)
  db_connection_string         String
  databaseName                 String?
  databaseStatus               DatabaseStatus                      @default(CREATING)
  databaseCreatedAt            DateTime?
  databaseLastSync             DateTime?
  isActive                     Boolean                             @default(true)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  createdBy                    String
  deletedAt                    DateTime?
  subdomain                    String?                             @unique
  logo                         String?
  website                      String?
  description                  String?
  timezone                     String?                             @default("UTC")
  currency                     String?                             @default("INR")
  language                     String?                             @default("en")
  settings                     Json?
  appointments                 Appointment[]
  appointmentTemplates         AppointmentTemplate[]
  ayurvedicTherapies           AyurvedicTherapy[]
  businessRules                BusinessRule[]
  checkInLocations             CheckInLocation[]
  admins                       ClinicAdmin[]
  doctors                      DoctorClinic[]
  eligibilityChecks            EligibilityCheck[]
  eligibilityCriteria          EligibilityCriteria[]
  rbacRoles                    RbacRole[]
  receptionists                Receptionist[]
  pharmacists                  Pharmacist[]
  therapists                   Therapist[]
  labTechnicians               LabTechnician[]
  financeBilling               FinanceBilling[]
  supportStaff                 SupportStaff[]
  nurses                       Nurse[]
  counselors                   Counselor[]
  recurringSeries              RecurringAppointmentSeries[]
  followUpPlans                FollowUpPlan[]
  resources                    Resource[]
  resourceBookings             ResourceBooking[]
  rolePermissions              RolePermission[]
  therapyQueues                TherapyQueue[]
  assistantCoverageAssignments AssistantDoctorCoverageAssignment[]
  therapySessions              TherapySession[]
  userRoles                    UserRole[]
  waitlistEntries              WaitlistEntry[]
  ReceptionistsAtClinic        ReceptionistsAtClinic[]
  locations                    ClinicLocation[]
  createdByUser                User                                @relation("UserCreatedClinics", fields: [createdBy], references: [id])
  primaryUsers                 User[]                              @relation("UserPrimaryClinic")
  videoConsultations           VideoConsultation[]
  users                        User[]                              @relation("UserClinics")
  checkIns                     CheckIn[]
  locationHeads                LocationHead[]
  emailSuppressions            EmailSuppressionList[]
  whatsappSuppressions         WhatsAppSuppressionList[]
  suppliers                    Supplier[]
  clinicExpenses               ClinicExpense[]
  insuranceClaims              InsuranceClaim[]
  communicationTemplates       CommunicationTemplate[]
  wards                        Ward[]
  beds                         Bed[]
  admissions                   Admission[]
  bedCharges                   BedCharge[]
  dischargeSummaries           DischargeSummary[]
  nursingNotes                 NursingNote[]
  vitalsFlowsheets             VitalsFlowsheet[]
  bedsideMedications           BedsideMedication[]

  @@index([app_name])
  @@index([isActive])
  @@map("clinics")
}

model ClinicLocation {
  id               String            @id @default(uuid())
  locationId       String            @unique
  name             String
  address          String
  city             String
  state            String
  country          String
  zipCode          String?
  phone            String?
  email            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  clinicId         String
  latitude         Float?
  longitude        Float?
  timezone         String?           @default("UTC")
  workingHours     Json?
  settings         Json?
  appointments     Appointment[]
  doctorClinic     DoctorClinic[]
  clinicAdmins     ClinicAdmin[]
  receptionists    Receptionist[]
  pharmacists      Pharmacist[]
  therapists       Therapist[]
  labTechnicians   LabTechnician[]
  financeBilling   FinanceBilling[]
  supportStaff     SupportStaff[]
  nurses           Nurse[]
  counselors       Counselor[]
  locationHeads    LocationHead[]
  prescriptions    Prescription[]
  queues           Queue[]
  checkInLocations CheckInLocation[]
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  medicines        Medicine[]
  wards            Ward[]
  beds             Bed[]
  admissions       Admission[]
  bedCharges       BedCharge[]
  dischargeSummaries DischargeSummary[]
  nursingNotes     NursingNote[]
  vitalsFlowsheets  VitalsFlowsheet[]
  bedsideMedications BedsideMedication[]

  @@index([clinicId])
  @@map("clinic_locations")
}

model Ward {
  id               String         @id @default(uuid())
  clinicId         String
  clinicLocationId  String
  name             String
  wardType         String
  location         String?
  totalBeds        Int            @default(0)
  defaultDailyRate Float?
  isActive         Boolean        @default(true)
  notes            String?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  clinicLocation   ClinicLocation @relation(fields: [clinicLocationId], references: [id])
  beds             Bed[]
  admissions       Admission[]
  bedAssignments   BedAssignment[]

  @@unique([clinicId, clinicLocationId, name])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([wardType])
  @@map("wards")
}

model Bed {
  id               String         @id @default(uuid())
  clinicId         String
  clinicLocationId  String
  wardId           String
  bedNumber        String
  roomNumber       String?
  bedType          String?
  dailyRate        Float?
  hasOxygen        Boolean        @default(false)
  hasVentilator    Boolean        @default(false)
  features         Json?
  status           String         @default("AVAILABLE")
  notes            String?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
  clinicLocation   ClinicLocation @relation(fields: [clinicLocationId], references: [id])
  ward             Ward           @relation(fields: [wardId], references: [id])
  admissions       Admission[]
  bedAssignments   BedAssignment[]

  @@unique([wardId, bedNumber])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([wardId])
  @@index([status])
  @@map("beds")
}

model Admission {
  id                   String               @id @default(uuid())
  admissionNumber      String               @unique
  patientId            String
  clinicId             String
  clinicLocationId     String
  wardId               String
  bedId                String
  admittingDoctorId    String
  status               String               @default("ADMITTED")
  admittedAt           DateTime             @default(now())
  primaryDiagnosis     String?
  secondaryDiagnoses   Json?
  admissionReason      String
  expectedDischargeDate DateTime?
  referringDoctor      String?
  attendantName       String?
  attendantPhone      String?
  insuranceDetails    Json?
  notes               String?
  dischargedAt        DateTime?
  dischargeType       String?
  dischargedById      String?
  finalDiagnosis      String?
  treatmentSummary    String?
  followUpInstructions String?
  followUpDate        DateTime?
  dischargeMedications Json?
  dischargeAdvice     String?
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  clinicLocation      ClinicLocation       @relation(fields: [clinicLocationId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  ward                Ward                 @relation(fields: [wardId], references: [id])
  bed                 Bed                  @relation(fields: [bedId], references: [id])
  bedAssignments      BedAssignment[]
  bedCharges          BedCharge[]
  dischargeSummary    DischargeSummary?
  nursingNotes        NursingNote[]
  vitalsFlowsheets    VitalsFlowsheet[]
  bedsideMedications  BedsideMedication[]

  @@unique([clinicId, admissionNumber])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([patientId])
  @@index([wardId])
  @@index([bedId])
  @@index([status])
  @@map("admissions")
}

model BedAssignment {
  id             String    @id @default(uuid())
  admissionId    String
  bedId          String
  wardId         String
  assignedAt     DateTime  @default(now())
  releasedAt     DateTime?
  isActive       Boolean   @default(true)
  transferReason String?
  authorizedBy   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  admission      Admission @relation(fields: [admissionId], references: [id])
  bed            Bed       @relation(fields: [bedId], references: [id])
  ward           Ward      @relation(fields: [wardId], references: [id])

  @@index([admissionId])
  @@index([bedId])
  @@index([wardId])
  @@index([isActive])
  @@map("bed_assignments")
}

model BedCharge {
  id             String    @id @default(uuid())
  admissionId    String
  patientId      String
  clinicId       String
  clinicLocationId String
  chargeDate     DateTime
  days           Int
  bedRate        Float
  bedCharges     Float
  totalCharges   Float
  isBilled       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  admission      Admission @relation(fields: [admissionId], references: [id])
  clinic         Clinic    @relation(fields: [clinicId], references: [id])
  clinicLocation ClinicLocation @relation(fields: [clinicLocationId], references: [id])
  patient        Patient   @relation(fields: [patientId], references: [id])

  @@unique([admissionId, chargeDate])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([patientId])
  @@index([chargeDate])
  @@map("bed_charges")
}

model DischargeSummary {
  id                     String    @id @default(uuid())
  admissionId            String    @unique
  patientId              String
  clinicId               String
  clinicLocationId       String
  finalDiagnosis         String?
  treatmentSummary       String?
  dischargeType          String
  dischargedAt           DateTime
  dischargedById         String?
  followUpInstructions   String?
  followUpDate           DateTime?
  dischargeMedications   Json?
  dischargeAdvice        String?
  notes                  String?
  nursingNotesCount      Int       @default(0)
  vitalsEntriesCount     Int       @default(0)
  medicationsAdministered Int      @default(0)
  pdfGenerated           Boolean   @default(false)
  pdfUrl                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  admission              Admission @relation(fields: [admissionId], references: [id])
  clinic                 Clinic    @relation(fields: [clinicId], references: [id])
  clinicLocation         ClinicLocation @relation(fields: [clinicLocationId], references: [id])

  @@index([clinicId])
  @@index([clinicLocationId])
  @@map("discharge_summaries")
}

model NursingNote {
  id            String    @id @default(uuid())
  admissionId   String
  patientId     String
  clinicId      String
  clinicLocationId String
  severity      String
  content       String
  recordedBy    String?
  recordedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  admission     Admission @relation(fields: [admissionId], references: [id])
  patient       Patient   @relation(fields: [patientId], references: [id])
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  clinicLocation ClinicLocation @relation(fields: [clinicLocationId], references: [id])

  @@index([admissionId])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([recordedAt])
  @@map("nursing_notes")
}

model VitalsFlowsheet {
  id            String    @id @default(uuid())
  admissionId   String
  patientId     String
  clinicId      String
  clinicLocationId String
  bpSystolic    Int?
  bpDiastolic   Int?
  heartRate     Int?
  temperature   Float?
  respiratoryRate Int?
  oxygenSaturation Int?
  bloodGlucose  Float?
  weight        Float?
  height        Float?
  bmi           Float?
  painScore     Int?
  recordedBy    String
  notes         String?
  recordedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  admission     Admission @relation(fields: [admissionId], references: [id])
  patient       Patient   @relation(fields: [patientId], references: [id])
  clinic        Clinic    @relation(fields: [clinicId], references: [id])
  clinicLocation ClinicLocation @relation(fields: [clinicLocationId], references: [id])
  recordedByUser User     @relation("IpdVitalsRecordedBy", fields: [recordedBy], references: [id])

  @@index([admissionId])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([recordedAt])
  @@map("vitals_flowsheets")
}

model BedsideMedication {
  id                String    @id @default(uuid())
  admissionId       String
  patientId         String
  clinicId          String
  clinicLocationId  String
  medicationName    String
  dosage            String
  route             String
  frequency         String?
  administeredBy    String
  verifiedById      String?
  administeredAt    DateTime  @default(now())
  batchNumber       String?
  adverseReactions  String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  admission         Admission @relation(fields: [admissionId], references: [id])
  patient           Patient   @relation(fields: [patientId], references: [id])
  clinic            Clinic    @relation(fields: [clinicId], references: [id])
  clinicLocation    ClinicLocation @relation(fields: [clinicLocationId], references: [id])
  administeredByUser User    @relation("IpdMedicationAdministeredBy", fields: [administeredBy], references: [id])
  verifiedByUser     User?    @relation("IpdMedicationVerifiedBy", fields: [verifiedById], references: [id])

  @@index([admissionId])
  @@index([clinicId])
  @@index([clinicLocationId])
  @@index([administeredAt])
  @@map("bedside_medications")
}

model SuperAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ClinicAdmin {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String
  locationId String?
  createdAt  DateTime        @default(now())
  isOwner    Boolean         @default(false)
  clinic     Clinic          @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model Pharmacist {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model Therapist {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model LabTechnician {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model FinanceBilling {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model SupportStaff {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model Nurse {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model Counselor {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String?
  locationId String?
  createdAt  DateTime        @default(now())
  clinic     Clinic?         @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([clinicId])
  @@index([locationId])
}

model LocationHead {
  id         String          @id @default(uuid())
  userId     String          @unique
  clinicId   String
  locationId String?
  assignedAt DateTime        @default(now())
  assignedBy String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  clinic     Clinic          @relation(fields: [clinicId], references: [id])
  location   ClinicLocation? @relation(fields: [locationId], references: [id])
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId, locationId])
  @@index([clinicId])
  @@index([locationId])
  @@index([isActive])
}

model Doctor {
  id                           String                              @id @default(uuid())
  userId                       String                              @unique
  specialization               String
  experience                   Int
  qualification                String?
  consultationFee              Float?
  rating                       Float?                              @default(0.0)
  isAvailable                  Boolean                             @default(true)
  workingHours                 Json?
  createdAt                    DateTime                            @default(now())
  appointments                 Appointment[]
  appointmentTemplates         AppointmentTemplate[]
  user                         User                                @relation(fields: [userId], references: [id])
  clinics                      DoctorClinic[]
  healthRecords                HealthRecord[]
  prescriptions                Prescription[]
  reviews                      Review[]
  therapySessions              TherapySession[]
  waitlistEntries              WaitlistEntry[]
  videoConsultations           VideoConsultation[]
  followUpPlans                FollowUpPlan[]
  primaryCoverageAssignments   AssistantDoctorCoverageAssignment[] @relation("AssistantCoveragePrimaryDoctor")
  assistantCoverageAssignments AssistantDoctorCoverageAssignment[] @relation("AssistantCoverageAssistantDoctor")
}

model Patient {
  id                 String                       @id @default(uuid())
  userId             String                       @unique
  prakriti           Prakriti?
  dosha              Dosha?
  createdAt          DateTime                     @default(now())
  appointments       Appointment[]
  checkIns           CheckIn[]
  eligibilityChecks  EligibilityCheck[]
  healthRecords      HealthRecord[]
  insurance          Insurance[]
  admissions         Admission[]
  bedCharges         BedCharge[]
  nursingNotes       NursingNote[]
  vitalsFlowsheets   VitalsFlowsheet[]
  bedsideMedications BedsideMedication[]
  user               User                         @relation(fields: [userId], references: [id])
  prescriptions      Prescription[]
  queueEntries       QueueEntry[]
  recurringSeries    RecurringAppointmentSeries[]
  followUpPlans      FollowUpPlan[]
  reviews            Review[]
  therapySessions    TherapySession[]
  waitlistEntries    WaitlistEntry[]
  videoConsultations VideoConsultation[]
  insuranceClaims    InsuranceClaim[]
  familyMembers      FamilyMember[]               @relation("PatientFamilyMembers")
}

model FamilyMember {
  id              String        @id @default(uuid())
  patientId       String
  userId          String?
  firstName       String
  lastName        String
  relation        String
  gender          String?
  dateOfBirth     DateTime?
  phone           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  createdByUserId String?
  notes           String?
  patient         Patient       @relation("PatientFamilyMembers", fields: [patientId], references: [id], onDelete: Cascade)
  user            User?         @relation("PrimaryPatientFamilyMembers", fields: [userId], references: [id])
  createdByUser   User?         @relation("FamilyMemberCreatedByUser", fields: [createdByUserId], references: [id])
  appointments    Appointment[]

  @@index([patientId])
  @@index([userId])
  @@index([createdByUserId])
  @@map("family_members")
}

model Appointment {
  id                    String            @id @default(uuid())
  type                  AppointmentType
  treatmentType         TreatmentType     @default(GENERAL_CONSULTATION)
  doctorId              String
  patientId             String
  familyMemberId        String?
  locationId            String? // Optional for VIDEO_CALL (uses virtual/online)
  clinicId              String
  date                  DateTime
  time                  String
  proposedSlots         Json? // Video flow: [{date, time}...] proposed by patient (3-4 slots)
  confirmedSlotIndex    Int? // Video flow: 0-based index of slot doctor selected
  duration              Int
  status                AppointmentStatus
  priority              String?           @default("NORMAL")
  notes                 String?
  userId                String
  updatedBy             String?
  cancellationReason    String?
  metadata              Json?
  cancelledBy           String?
  cancelledAt           DateTime?
  // ─── Payment window (VIDEO_CALL only) ───────────────────────────
  // When set, the patient must complete payment before this time or
  // the appointment will be auto-cancelled. NULL for in-person / non-payable.
  paymentExpiresAt      DateTime?
  // ─── Confirmation window ───────────────────────────────────────
  // Set when an appointment transitions to CONFIRMED. The backend
  // scheduler auto-expires the appointment at this time if no one
  // completes the visit. Window length is `VIDEO_ACTIVE_WINDOW_MINUTES`
  // (default 300 = 5h) measured from the scheduled start. NULL for
  // appointments that haven't been confirmed yet (or already reached a
  // terminal status).
  confirmationExpiresAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  therapyId             String?
  startedAt             DateTime?
  checkedInAt           DateTime?
  completedAt           DateTime?
  subscriptionId        String?
  isSubscriptionBased   Boolean           @default(false)

  // Follow-up relationships
  parentAppointmentId  String?
  parentAppointment    Appointment?  @relation("AppointmentFollowUps", fields: [parentAppointmentId], references: [id])
  followUpAppointments Appointment[] @relation("AppointmentFollowUps")

  // Recurring series
  seriesId       String?
  series         RecurringAppointmentSeries? @relation(fields: [seriesId], references: [id])
  seriesSequence Int? // Position in series (1, 2, 3...)

  // Follow-up metadata
  isFollowUp            Boolean @default(false)
  followUpReason        String? // Why this follow-up was created
  originalAppointmentId String? // Original appointment that triggered this

  // Relations
  clinic       Clinic          @relation(fields: [clinicId], references: [id])
  doctor       Doctor          @relation(fields: [doctorId], references: [id])
  location     ClinicLocation? @relation(fields: [locationId], references: [id])
  patient      Patient         @relation(fields: [patientId], references: [id])
  familyMember FamilyMember?   @relation(fields: [familyMemberId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  therapy      Therapy?        @relation(fields: [therapyId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  // Follow-up plan relation (one-to-one: appointment can have one follow-up plan)
  followUpPlan FollowUpPlan? @relation("AppointmentFollowUpPlan")

  // Reverse relation for follow-up appointments created from plans
  followUpPlanFrom FollowUpPlan? @relation("FollowUpAppointment")

  // Existing relations
  checkIns          CheckIn[]
  payment           Payment?
  queue             Queue?
  queueEntries      QueueEntry[]
  resourceBookings  ResourceBooking[]
  therapySessions   TherapySession[]
  VideoConsultation VideoConsultation[]
  insuranceClaims   InsuranceClaim[]

  // Single-column indexes (existing)
  @@index([doctorId])
  @@index([patientId])
  @@index([familyMemberId])
  @@index([locationId])
  @@index([clinicId])
  @@index([subscriptionId])
  @@index([parentAppointmentId])
  @@index([seriesId])
  @@index([isFollowUp])
  @@index([originalAppointmentId])
  // ✅ Composite indexes for common query patterns (10M+ users optimization)
  @@index([doctorId, clinicId, date]) // Doctor's daily schedule queries
  @@index([patientId, status, date]) // Patient's pending/upcoming appointments
  @@index([clinicId, date, status]) // Clinic's daily appointments by status
  @@index([clinicId, isFollowUp, type]) // Clinic's follow-ups by type
  @@index([parentAppointmentId, date]) // Follow-up chains chronologically
  @@index([seriesId, seriesSequence]) // Recurring series order
}

